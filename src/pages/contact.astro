---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact — SIONIWEB"><section class="contact"><div class="eyebrow">Start a project</div><h1>Votre prochain projet<br /><i>commence ici.</i></h1><div class="contact-grid"><div><p>Parlez-nous de votre lieu, de votre idée ou de ce qui ne ressemble pas encore à un brief.</p><a href="mailto:hello@sioniweb.fr">hello@sioniweb.fr ↗</a><a href="https://instagram.com">Instagram</a><a href="https://linkedin.com">LinkedIn</a></div><form action="mailto:hello@sioniweb.fr" method="post" enctype="text/plain"><label>Nom<input required name="name" /></label><label>Entreprise<input name="company" /></label><label>Email<input required type="email" name="email" /></label><label>Type de projet<select name="project"><option>Website</option><option>Photography</option><option>Website + Photography</option><option>Content</option><option>Other</option></select></label><label>Budget indicatif<select name="budget"><option>À définir ensemble</option><option>500–1 000 €</option><option>1 000–2 000 €</option><option>2 000–5 000 €</option><option>5 000 €+</option></select></label><label>Message<textarea required name="message" rows="4"></textarea></label><button>Envoyer le projet <b>↗</b></button></form></div></section></BaseLayout>
<style>.contact{background:var(--ink);color:var(--paper);padding:22vh 3vw 12vw}.contact h1{font-size:clamp(50px,8.6vw,136px);letter-spacing:-.1em;line-height:.86;margin:8vw 0 11vw}.contact h1 i{font-weight:400}.contact-grid{display:grid;grid-template-columns:1fr 1.4fr;gap:10vw}.contact-grid>div p{font-size:22px;line-height:1.2;max-width:320px;margin:0 0 40px}.contact-grid>div a{display:block;margin:8px 0;border-bottom:1px solid rgba(243,241,235,.3);padding-bottom:7px;max-width:260px}form{display:grid;grid-template-columns:1fr 1fr;gap:26px 20px}label{font:10px var(--mono);text-transform:uppercase}input,select,textarea{display:block;width:100%;border:0;border-bottom:1px solid rgba(243,241,235,.5);background:transparent;color:var(--paper);font:500 17px var(--sans);padding:11px 0;outline:none;border-radius:0}select option{color:var(--ink)}textarea{resize:vertical}label:last-of-type{grid-column:1/-1}button{grid-column:2;background:var(--lime);color:var(--ink);border:0;padding:17px;font:600 14px var(--sans);cursor:pointer}button b{margin-left:24px}@media(max-width:720px){.contact{padding:160px 20px 80px}.contact-grid{grid-template-columns:1fr;gap:65px}form{grid-template-columns:1fr}button{grid-column:auto}}</style>
