---
import BaseLayout from '../layouts/BaseLayout.astro';
const services = [
  ['01','Web','Des sites sur mesure pour présenter votre activité, rassurer vos clients et transformer les visites en contacts.','Direction artistique · UX/UI · Développement · SEO local · Performance'],
  ['02','Photography','Des images construites autour de votre identité, de votre environnement et de vos vrais détails.','Commerce · Produit · Portrait · Équipe · Lifestyle · Événements'],
  ['03','Content','Du contenu pensé pour faire vivre votre marque après la mise en ligne.','Photographie sociale · Vidéos verticales · BTS · Lancement · Contenus réguliers'],
];
---
<BaseLayout title="Services — SIONIWEB"><section class="intro"><div class="eyebrow">What we can build</div><h1>Pas une liste de services.<br /><i>Un système pour votre image.</i></h1></section><section class="services">{services.map(([number,title,copy,items]) => <article><div class="number">{number}</div><h2>{title}</h2><p>{copy}</p><small>{items}</small></article>)}</section><section class="closing"><p>Vous n’avez pas à rentrer dans une case. Nous composons l’intervention adaptée à votre projet.</p><a href="/contact">Démarrer un projet ↗</a></section></BaseLayout>
<style>.intro{background:var(--ink);color:var(--paper);padding:22vh 3vw 10vw}.intro h1{font-size:clamp(48px,8.4vw,135px);line-height:.89;letter-spacing:-.09em;margin:9vw 0 0}.intro i{font-weight:400}.services{padding:2vw 3vw 12vw}.services article{border-bottom:1px solid var(--line);padding:3vw 0 4vw;display:grid;grid-template-columns:10% 28% 1fr;gap:4vw}.number,small{font:10px var(--mono);text-transform:uppercase}.services h2{font-size:clamp(33px,5vw,72px);letter-spacing:-.08em;line-height:.9;margin:0}.services p{font-size:clamp(20px,2.2vw,31px);line-height:1.15;max-width:650px;margin:0}.services small{grid-column:3}.closing{background:var(--lime);padding:10vw 3vw}.closing p{font-size:clamp(34px,5vw,78px);line-height:.97;letter-spacing:-.08em;max-width:1100px;margin:0}.closing a{display:inline-block;margin-top:70px;border-bottom:1px solid}@media(max-width:720px){.intro{padding:165px 20px 80px}.services{padding:0 20px 80px}.services article{padding:35px 0;grid-template-columns:35px 1fr;gap:15px}.services p{grid-column:2}.services small{grid-column:2;line-height:1.6}.closing{padding:70px 20px}}</style>
