---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/projects';
export function getStaticPaths() { return projects.map((project) => ({ params: { slug: project.slug }, props: { project } })); }
const { project } = Astro.props;
const next = projects[(projects.findIndex((p) => p.slug === project.slug) + 1) % projects.length];
---
<BaseLayout title={`${project.title} — SIONIWEB`} description={project.intro}>
  <article>
    <section class="case-hero"><div class="eyebrow">{project.number} — {project.type}</div><h1>{project.title}</h1><p>{project.intro}</p><div class="case-info"><span>Client<br /><b>{project.title}</b></span><span>Services<br /><b>{project.type.replaceAll(' · ', ', ')}</b></span><span>Year<br /><b>{project.year}</b></span><span>Location<br /><b>{project.location}</b></span></div></section>
    <img class="cover" src={project.image} alt={`Univers ${project.title}`} />
    <section class="story"><div class="eyebrow">The context</div><p>{project.challenge}</p><div class="split"><div><span class="eyebrow">The approach</span><p>{project.approach}</p></div><div><span class="eyebrow">The outcome</span><p>{project.result}</p></div></div></section>
    <section class="image-detail"><img src={project.image} alt="Détail du projet" /><div><span class="eyebrow">Built for the everyday</span><p>Une expérience pensée avec attention : dans ses mots, son rythme et ses détails. Sans bruit inutile.</p></div></section>
    <a class="next" href={`/work/${next.slug}`} style={`background-image:linear-gradient(90deg,rgba(18,18,16,.8),rgba(18,18,16,.2)),url(${next.image})`}><span class="eyebrow">Next project</span><h2>{next.title} <b>↗</b></h2></a>
  </article>
</BaseLayout>
<style>
 .case-hero{background:var(--ink);color:var(--paper);padding:22vh 3vw 5vw}.case-hero h1{font-size:clamp(61px,11vw,170px);letter-spacing:-.1em;line-height:.8;margin:7vw 0 3vw}.case-hero>p{font-size:clamp(20px,2.4vw,34px);line-height:1.12;max-width:650px;margin:0 0 11vw}.case-info{border-top:1px solid rgba(243,241,235,.3);padding-top:14px;display:grid;grid-template-columns:repeat(4,1fr);gap:16px;font:10px var(--mono);text-transform:uppercase}.case-info b{font:500 11px var(--sans);text-transform:none;display:block;max-width:200px;margin-top:5px}.cover{width:100%;max-height:90vh;object-fit:cover}.story{padding:14vw 3vw}.story>p{font-size:clamp(35px,5.1vw,82px);line-height:1;letter-spacing:-.075em;max-width:1100px;margin:8vw 0 14vw}.split{display:grid;grid-template-columns:1fr 1fr;gap:7vw;margin-left:34%}.split p{font-size:19px;line-height:1.3;margin-top:18px}.image-detail{background:var(--warm);padding:8vw 3vw;display:grid;grid-template-columns:1.3fr .7fr;gap:8vw;align-items:end}.image-detail img{width:100%;aspect-ratio:4/5;object-fit:cover}.image-detail p{font-size:clamp(24px,3vw,45px);letter-spacing:-.06em;line-height:1.05}.next{min-height:72vw;background-size:cover;background-position:center;color:var(--paper);display:flex;flex-direction:column;justify-content:flex-end;padding:4vw 3vw;position:relative}.next h2{font-size:clamp(50px,8vw,125px);letter-spacing:-.09em;line-height:.85;margin:25px 0 0}.next b{font-weight:400}@media(max-width:720px){.case-hero{padding:160px 20px 50px}.case-hero>p{margin:40px 0 70px}.case-info{grid-template-columns:1fr 1fr;gap:24px}.story{padding:100px 20px}.story>p{margin:50px 0 70px}.split{grid-template-columns:1fr;margin:0;gap:35px}.split p{font-size:17px}.image-detail{display:block;padding:20px 20px 65px}.image-detail p{margin-top:45px}.next{min-height:120vw;padding:30px 20px}}
</style>
