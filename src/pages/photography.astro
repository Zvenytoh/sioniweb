---
import BaseLayout from '../layouts/BaseLayout.astro';
const images = ['/images/akoyas-hair.webp','/images/william-coaching.webp','/images/20000-jeux.webp','/images/william-coaching.webp','/images/akoyas-hair.webp'];
---
<BaseLayout title="Photography — SIONIWEB"><section class="photo-hero"><div class="eyebrow">Photography — Selected frames</div><h1>Le réel<br />en première ligne.</h1><p>Des images qui donnent une matière, une lumière et une mémoire à votre activité.</p></section><section class="gallery">{images.map((image, index) => <figure class={`frame frame-${index + 1}`}><img src={image} alt="Sélection photographique SIONIWEB" loading="lazy" /><figcaption>{['People','Movement','Retail','Detail','Atmosphere'][index]} — 2026</figcaption></figure>)}</section></BaseLayout>
<style>.photo-hero{min-height:83svh;background:var(--ink);color:var(--paper);padding:22vh 3vw 7vw;display:flex;flex-direction:column;justify-content:space-between}.photo-hero h1{font-size:clamp(70px,12vw,185px);line-height:.75;letter-spacing:-.1em;margin:0}.photo-hero p{align-self:flex-end;font-size:20px;max-width:330px}.gallery{padding:8vw 3vw;display:grid;grid-template-columns:repeat(12,1fr);gap:2vw}.frame{margin:0}.frame img{width:100%;height:100%;object-fit:cover;filter:saturate(.9)}.frame figcaption{font:10px var(--mono);text-transform:uppercase;margin-top:9px}.frame-1{grid-column:1/8;height:51vw}.frame-2{grid-column:9/13;height:31vw;margin-top:17vw}.frame-3{grid-column:3/13;height:58vw;margin-top:8vw}.frame-4{grid-column:1/6;height:41vw;margin-top:5vw}.frame-5{grid-column:7/12;height:47vw;margin-top:20vw}@media(max-width:720px){.photo-hero{padding:160px 20px 60px}.photo-hero p{align-self:flex-start;margin-top:50px}.gallery{display:block;padding:50px 20px}.frame,.frame-1,.frame-2,.frame-3,.frame-4,.frame-5{height:auto;margin:0 0 38px}.frame img{height:auto;aspect-ratio:4/5}}</style>
